#version 450

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

// Push Constants / Uniform block for full 32-bit linear development
layout(push_constant) uniform PipelineParams {
    // 1. WB & Tint
    vec3 wbGains;          // (rGain, gGain, bGain)
    vec3 shadowTint;       // (shadowR, shadowG, shadowB)

    // 2. Basic Tone
    float exposureMult;    // 2^EV
    float contrast;        // -1.0 to 1.0
    float highlights;      // -1.0 to 1.0
    float shadows;         // -1.0 to 1.0
    float whites;          // -1.0 to 1.0
    float blacks;          // -1.0 to 1.0
    float vibrance;        // -1.0 to 1.0
    float saturation;      // -1.0 to 1.0

    // 3. Tile geometry & padding
    ivec2 imageSize;       // Full image dimensions
    ivec2 tileOffset;      // (x, y) offset of this tile in full image
    ivec2 tileSize;        // (width, height) of valid tile without padding
    int padding;           // Padding pixels around valid tile

    // 4. Monochrome & Output
    int isMonochrome;
    int outputColorSpace;  // 0: sRGB, 1: Display P3, 2: AdobeRGB
    float sharpeningAmount;
    float luminanceNR;
    uint ditherSeed;
} params;

// Input buffer: Padded tile float RGBA
layout(std430, set = 0, binding = 0) readonly buffer InputBuffer {
    vec4 inPixels[];
};

// Output buffer: Valid tile float RGBA (or target format)
layout(std430, set = 0, binding = 1) writeonly buffer OutputBuffer {
    vec4 outPixels[];
};

// 8-band HSL adjustments buffer
layout(std430, set = 0, binding = 2) readonly buffer HslBuffer {
    vec4 hslAdjust[8]; // x: hueShift, y: saturation, z: luminance, w: unused
    vec4 monoWeights;  // weights 0..3
    vec4 monoWeights2; // weights 4..7
};

// Convert RGB to HSL
vec3 rgbToHsl(vec3 c) {
    float cMin = min(min(c.r, c.g), c.b);
    float cMax = max(max(c.r, c.g), c.b);
    float delta = cMax - cMin;
    vec3 hsl = vec3(0.0, 0.0, (cMax + cMin) * 0.5);

    if (delta > 1e-6) {
        hsl.y = hsl.z < 0.5 ? (delta / (cMax + cMin)) : (delta / (2.0 - cMax - cMin));
        if (c.r == cMax) {
            hsl.x = (c.g - c.b) / delta + (c.g < c.b ? 6.0 : 0.0);
        } else if (c.g == cMax) {
            hsl.x = (c.b - c.r) / delta + 2.0;
        } else {
            hsl.x = (c.r - c.g) / delta + 4.0;
        }
        hsl.x /= 6.0; // 0.0 to 1.0 (0 to 360 deg)
    }
    return hsl;
}

// Convert HSL back to RGB
float hueToRgb(float p, float q, float t) {
    if (t < 0.0) t += 1.0;
    if (t > 1.0) t -= 1.0;
    if (t < 1.0 / 6.0) return p + (q - p) * 6.0 * t;
    if (t < 1.0 / 2.0) return q;
    if (t < 2.0 / 3.0) return p + (q - p) * (2.0 / 3.0 - t) * 6.0;
    return p;
}

vec3 hslToRgb(vec3 hsl) {
    if (hsl.y < 1e-6) return vec3(hsl.z);
    float q = hsl.z < 0.5 ? (hsl.z * (1.0 + hsl.y)) : (hsl.z + hsl.y - hsl.z * hsl.y);
    float p = 2.0 * hsl.z - q;
    return vec3(
        hueToRgb(p, q, hsl.x + 1.0 / 3.0),
        hueToRgb(p, q, hsl.x),
        hueToRgb(p, q, hsl.x - 1.0 / 3.0)
    );
}

// Soft-knee highlight recovery
vec3 recoverHighlights(vec3 c, float amount) {
    if (amount <= 0.0) return c;
    // Knee threshold at 0.75
    const float threshold = 0.75;
    float maxC = max(max(c.r, c.g), c.b);
    if (maxC > threshold) {
        float excess = maxC - threshold;
        float compressed = threshold + (excess / (1.0 + excess * amount * 0.8));
        c *= (compressed / maxC);
    }
    return c;
}

// Soft shadow lift
vec3 liftShadows(vec3 c, float amount) {
    if (abs(amount) < 1e-5) return c;
    float lum = dot(c, vec3(0.2126, 0.7152, 0.0722));
    float lift = pow(1.0 - clamp(lum, 0.0, 1.0), 3.0) * (amount * 0.35);
    return max(vec3(0.0), c + vec3(lift));
}

// Apply skin-protected vibrance
vec3 applyVibrance(vec3 c, float vib) {
    if (abs(vib) < 1e-5) return c;
    float maxC = max(max(c.r, c.g), c.b);
    float minC = min(min(c.r, c.g), c.b);
    float sat = (maxC > 1e-5) ? (maxC - minC) / maxC : 0.0;

    // Skin protection: Hue around 20-40 degrees (0.05 to 0.12 in normalized hue)
    vec3 hsl = rgbToHsl(c);
    float hueDist = abs(hsl.x - 0.08);
    float skinWeight = clamp(1.0 - (hueDist / 0.10), 0.0, 1.0); // 1.0 in skin, 0.0 elsewhere

    // Lower boost for already saturated areas and skin tones
    float boost = vib * (1.0 - sat) * (1.0 - skinWeight * 0.75);
    float lum = dot(c, vec3(0.2126, 0.7152, 0.0722));
    return mix(vec3(lum), c, 1.0 + boost);
}

// Color space transfer function (OETF)
vec3 applyOETF(vec3 linearC, int cs) {
    vec3 res;
    if (cs == 2) {
        // AdobeRGB: gamma 2.1992
        res = pow(max(linearC, vec3(0.0)), vec3(1.0 / 2.19921875));
    } else {
        // sRGB / Display P3 transfer function
        for (int i = 0; i < 3; ++i) {
            float val = linearC[i];
            if (val <= 0.0031308) {
                res[i] = val * 12.92;
            } else {
                res[i] = 1.055 * pow(max(val, 0.0), 1.0 / 2.4) - 0.055;
            }
        }
    }
    return clamp(res, 0.0, 1.0);
}

void main() {
    ivec2 localId = ivec2(gl_GlobalInvocationID.xy);
    if (localId.x >= params.tileSize.x || localId.y >= params.tileSize.y) {
        return;
    }

    int paddedW = params.tileSize.x + 2 * params.padding;
    int padX = localId.x + params.padding;
    int padY = localId.y + params.padding;
    int paddedIdx = padY * paddedW + padX;

    vec4 pix = inPixels[paddedIdx];
    vec3 col = pix.rgb;

    // 1. White Balance & Tint
    col *= params.wbGains;
    // Shadow tint lift
    col += params.shadowTint * pow(1.0 - clamp(dot(col, vec3(0.2126, 0.7152, 0.0722)), 0.0, 1.0), 2.0);

    // 2. Exposure
    col *= params.exposureMult;

    // 3. Highlight Recovery & Shadow Lift
    col = recoverHighlights(col, params.highlights);
    col = liftShadows(col, params.shadows);

    // 4. Contrast around 0.18 middle gray pivot
    if (abs(params.contrast) > 1e-5) {
        float factor = (1.0 + params.contrast * 0.5);
        col = pow(max(col / 0.18, vec3(0.0)), vec3(factor)) * 0.18;
    }

    // 5. White & Black levels
    col = max(vec3(0.0), col - vec3(params.blacks * 0.05));
    if (abs(params.whites) > 1e-5) {
        col *= (1.0 + params.whites * 0.5);
    }

    // 6. 8-Color Mixer or Monochrome
    if (params.isMonochrome != 0) {
        // 8-channel optical filter monochrome mixing
        vec3 hsl = rgbToHsl(col);
        // Map hue to 8 bands
        float hNorm = hsl.x * 8.0;
        int b0 = int(floor(hNorm)) % 8;
        int b1 = (b0 + 1) % 8;
        float frac = fract(hNorm);

        float w0 = (b0 < 4) ? monoWeights[b0] : monoWeights2[b0 - 4];
        float w1 = (b1 < 4) ? monoWeights[b1] : monoWeights2[b1 - 4];
        float bandWeight = mix(w0, w1, frac);

        float gray = dot(col, vec3(0.2126, 0.7152, 0.0722)) * (1.0 + (bandWeight - 0.125) * 2.0);
        col = vec3(max(0.0, gray));
    } else {
        // 8-band HSL adjustment
        vec3 hsl = rgbToHsl(col);
        float h8 = hsl.x * 8.0;
        int b0 = int(floor(h8)) % 8;
        int b1 = (b0 + 1) % 8;
        float frac = fract(h8);

        vec4 adj0 = hslAdjust[b0];
        vec4 adj1 = hslAdjust[b1];
        vec4 adj = mix(adj0, adj1, frac);

        hsl.x = fract(hsl.x + adj.x * (1.0 / 360.0));
        hsl.y = clamp(hsl.y * (1.0 + adj.y), 0.0, 1.0);
        hsl.z = clamp(hsl.z * (1.0 + adj.z), 0.0, 1.0);
        col = hslToRgb(hsl);

        // 7. Vibrance & Saturation
        col = applyVibrance(col, params.vibrance);
        if (abs(params.saturation) > 1e-5) {
            float lum = dot(col, vec3(0.2126, 0.7152, 0.0722));
            col = mix(vec3(lum), col, 1.0 + params.saturation);
        }
    }

    // 8. Output Color Space OETF (Transfer Function)
    vec3 outputCol = applyOETF(col, params.outputColorSpace);

    int outIdx = localId.y * params.tileSize.x + localId.x;
    outPixels[outIdx] = vec4(outputCol, pix.a);
}
